# Copy to .env.local and fill in. None of these are required for v1.

# Once you buy a domain, set this so metadata URLs are absolute.
NEXT_PUBLIC_SITE_URL=https://your-domain.gg

# Google AdSense publisher ID (format: ca-pub-xxxxxxxxxxxxxxxx)
# Leave blank until AdSense approves the site.
NEXT_PUBLIC_ADSENSE_CLIENT=

# For future Blizzard Battle.net API integration (tools #2 and #3).
# Register an app at https://develop.battle.net/
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
