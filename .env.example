# Web credentials belong only in Vercel. Never mount them on the public MCP host.
NEXT_PUBLIC_SITE_URL=https://everloot.app
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=everloot-uploads
CRON_SECRET=
# The secret census GUIDs are hashed under before storage (docs/DATA_POLICY.md). Empty: census rows are dropped.
EVERLOOT_CHARACTER_KEY=
# Player pages (docs/design/specs/2026-10-20-player-pages-design.md). Both off unless set to 1; the second needs the first.
EVERLOOT_PLAYER_PAGES=
EVERLOOT_PLAYER_PAGES_INDEX=
# Maintenance only: private database connection and Supabase root CA file.
POSTGRES_URL_NON_POOLING=
SUPABASE_DB_CA_PATH=
