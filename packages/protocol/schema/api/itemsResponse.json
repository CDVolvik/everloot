{
  "$id": "https://everloot.app/schema/api/itemsResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "gameData": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "The evidence label pages show, such as \"found in game files, unconfirmed\"."
        },
        "build": {
          "type": "string",
          "description": "The game build the rows were read from."
        },
        "extractedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "credit": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "build"
      ],
      "additionalProperties": {}
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "next": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "generatedAt",
    "items",
    "gameData",
    "offset",
    "limit",
    "total",
    "next"
  ],
  "additionalProperties": false
}
