{
  "$id": "https://everloot.app/schema/api/marketPricesResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "dataAsOf": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule": {
      "type": "string",
      "description": "How a day becomes public and how the values are computed."
    },
    "fields": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "itemId"
        },
        {
          "type": "string",
          "const": "market"
        },
        {
          "type": "string",
          "const": "min"
        },
        {
          "type": "string",
          "const": "historical"
        },
        {
          "type": "string",
          "const": "quantity"
        },
        {
          "type": "string",
          "const": "day"
        },
        {
          "type": "string",
          "const": "reporters"
        }
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "realm": {
      "type": [
        "string",
        "null"
      ]
    },
    "house": {
      "description": "Present when the request named a house: the values come only from scans of that house.",
      "type": "string",
      "enum": [
        "Alliance",
        "Horde",
        "Neutral"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        ],
        "items": false,
        "minItems": 7,
        "maxItems": 7
      },
      "description": "[itemId, market, min, historical, quantity, day, reporters]; copper per unit."
    },
    "attribution": {
      "type": "object",
      "properties": {
        "licence": {
          "type": "string"
        },
        "licenceUrl": {
          "type": "string",
          "format": "uri"
        },
        "credit": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "terms": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "licence",
        "licenceUrl",
        "credit",
        "source",
        "terms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ok",
    "dataAsOf",
    "rule",
    "fields",
    "realm",
    "items",
    "attribution"
  ],
  "additionalProperties": false
}
