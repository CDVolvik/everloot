{
  "$id": "https://everloot.app/schema/mcp/guild_board.json",
  "title": "Guild board its officers published",
  "description": "One guild's roster, bosses killed, loot awarded, raid attendance and average item level, as that guild's own officers chose to publish them. Only uploads from officers holding a verified grant for the guild count, and a figure is public after 2 of them agree. Names are in-game character names, never accounts or real-world identities. A character's owner can opt out, and an opted-out character is left out of the roster, loot and attendance. A guild whose officers have not published gets an empty board; the tool does not look up other players or guilds. The average names how many roster members were measured; there is no combined score. Reads Everloot's current authorized public corpus when connected. Missing or unavailable data is reported explicitly.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "guildName": {
        "type": "string",
        "description": "Guild name."
      },
      "realm": {
        "type": "string",
        "description": "Realm name."
      }
    },
    "required": [
      "guildName",
      "realm"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "guildName": {
            "type": "string"
          },
          "realm": {
            "type": "string"
          },
          "memberCount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until officer uploads agree."
          },
          "roster": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "rank": {
                  "type": "string"
                },
                "level": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "className": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "rank",
                "level",
                "className"
              ],
              "additionalProperties": false
            }
          },
          "progression": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instance": {
                  "type": "string"
                },
                "bosses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "instance",
                "bosses"
              ],
              "additionalProperties": false
            }
          },
          "loot": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "recipient": {
                  "type": "string"
                },
                "sourceBoss": {
                  "type": "string"
                }
              },
              "required": [
                "itemId",
                "recipient",
                "sourceBoss"
              ],
              "additionalProperties": false
            }
          },
          "averageItemLevel": {
            "type": [
              "number",
              "null"
            ]
          },
          "gearCoverage": {
            "type": "object",
            "properties": {
              "measured": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "roster": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "measured",
              "roster"
            ],
            "additionalProperties": false,
            "description": "Roster members with one agreed item level, over the agreed roster."
          },
          "present": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attendanceWaiting": {
            "type": "boolean"
          }
        },
        "required": [
          "guildName",
          "realm",
          "memberCount",
          "roster",
          "progression",
          "loot",
          "averageItemLevel",
          "gearCoverage",
          "present",
          "attendanceWaiting"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "endsWith": "Licence: CC BY-SA 4.0. Credit: Everloot contributors, https://everloot.app"
  }
}
