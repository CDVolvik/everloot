{
  "$id": "https://everloot.app/schema/mcp/item_page.json",
  "title": "Item page for a drop",
  "description": "One Forever item: agreed name, public drop rate with kill count, and an agreed map pin. A rate is public after 3 installs kill the source. A name or pin needs 3 installs agreeing. No Wowhead rows. Reads Everloot's public player data when connected. Missing or unavailable data is reported explicitly.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "itemId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Item id from a drop row."
      }
    },
    "required": [
      "itemId"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "connected": {
        "type": "boolean",
        "description": "False when no corpus was read; the page is then absent, which is not a measured zero."
      },
      "dataAsOf": {
        "description": "The corpus snapshot time, or null when unrecorded.",
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "description": "Why nothing was read, when connected is false.",
        "type": "string"
      },
      "url": {
        "description": "The everloot.app page that shows this answer, absolute. Absent when there is no such page or it would be empty.",
        "type": "string"
      },
      "page": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "description": "Null until 3 installs report the same name.",
            "type": [
              "string",
              "null"
            ]
          },
          "drops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceNpcId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "sourceObjectId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "source": {
                  "type": "string",
                  "description": "The source in words, with its agreed name when it has one."
                },
                "kills": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Observed loot windows, not a census of kills."
                },
                "drops": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Windows with this item; 0 is a measured zero."
                },
                "rate": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "source",
                "kills",
                "drops",
                "rate",
                "reporters"
              ],
              "additionalProperties": false
            }
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "npcId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mapId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "reporters": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "npcId",
                "name",
                "mapId",
                "x",
                "y",
                "reporters"
              ],
              "additionalProperties": false
            },
            "description": "Agreed positions of the NPCs it drops from; a pin needs 3 installs on the same map."
          }
        },
        "required": [
          "itemId",
          "name",
          "drops",
          "pins"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "connected",
      "dataAsOf"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text",
    "endsWith": "Licence: CC BY-SA 4.0. Credit: Everloot contributors, https://everloot.app"
  }
}
