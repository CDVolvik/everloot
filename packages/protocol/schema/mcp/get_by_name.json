{
  "$id": "https://everloot.app/schema/mcp/get_by_name.json",
  "title": "Get records by exact name",
  "description": "Exact full-name match (case-insensitive) for disambiguation. Use search_knowledge for fuzzy matches.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 200,
        "description": "Full record name."
      },
      "kind": {
        "description": "Narrow to one record kind.",
        "type": "string",
        "enum": [
          "item",
          "npc",
          "object",
          "quest",
          "zone",
          "spell",
          "lore_page",
          "creator",
          "realm"
        ]
      }
    },
    "required": [
      "name"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "hits": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "The record id, for get_entity."
            },
            "extId": {
              "type": "string",
              "description": "The source's own id, such as a wiki page title."
            },
            "kind": {
              "type": "string",
              "enum": [
                "item",
                "npc",
                "object",
                "quest",
                "zone",
                "spell",
                "lore_page",
                "creator",
                "realm"
              ]
            },
            "name": {
              "type": "string"
            },
            "snippet": {
              "type": "string",
              "description": "A short excerpt, in the source's words."
            },
            "gameVersion": {
              "type": "string",
              "enum": [
                "forever",
                "classic",
                "retail",
                "lore"
              ]
            },
            "sourceUrl": {
              "type": "string",
              "description": "Where the record came from. Keep it with the text."
            },
            "sourceId": {
              "type": "string"
            },
            "licence": {
              "type": "string",
              "description": "The source's licence, such as CC-BY-SA-4.0."
            },
            "retrievedAt": {
              "type": "string",
              "description": "When the source was read."
            }
          },
          "required": [
            "id",
            "extId",
            "kind",
            "name",
            "snippet",
            "gameVersion",
            "sourceUrl",
            "sourceId",
            "licence",
            "retrievedAt"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "hits"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text"
  }
}
