{
  "$id": "https://everloot.app/schema/mcp/get_entity.json",
  "title": "Get one knowledge record by id",
  "description": "Fetch the full record behind a search hit id, for page rendering.",
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "Record id from a search_knowledge hit."
      }
    },
    "required": [
      "id"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "hit": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "The record id, for get_entity."
              },
              "extId": {
                "type": "string",
                "description": "The source's own id, such as a wiki page title."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "item",
                  "npc",
                  "object",
                  "quest",
                  "zone",
                  "spell",
                  "lore_page",
                  "creator",
                  "realm"
                ]
              },
              "name": {
                "type": "string"
              },
              "snippet": {
                "type": "string",
                "description": "A short excerpt, in the source's words."
              },
              "gameVersion": {
                "type": "string",
                "enum": [
                  "forever",
                  "classic",
                  "retail",
                  "lore"
                ]
              },
              "sourceUrl": {
                "type": "string",
                "description": "Where the record came from. Keep it with the text."
              },
              "sourceId": {
                "type": "string"
              },
              "licence": {
                "type": "string",
                "description": "The source's licence, such as CC-BY-SA-4.0."
              },
              "retrievedAt": {
                "type": "string",
                "description": "When the source was read."
              }
            },
            "required": [
              "id",
              "extId",
              "kind",
              "name",
              "snippet",
              "gameVersion",
              "sourceUrl",
              "sourceId",
              "licence",
              "retrievedAt"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "hit"
    ],
    "additionalProperties": false
  },
  "x-everloot-output": {
    "type": "text"
  }
}
