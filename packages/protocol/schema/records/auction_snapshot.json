{
  "$id": "https://everloot.app/schema/records/auction_snapshot.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "auction_snapshot"
    },
    "realm": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "faction": {
      "description": "The scanning character's faction. Scans from addons up to 0.3.3 have none.",
      "type": "string",
      "enum": [
        "Alliance",
        "Horde"
      ]
    },
    "house": {
      "description": "The auction house the scan read, from the auctioneer's faction: Neutral for a goblin house. Absent in older scans and when the addon could not tell.",
      "type": "string",
      "enum": [
        "Alliance",
        "Horde",
        "Neutral"
      ]
    },
    "scanId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "part": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "parts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "items": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        ],
        "items": false,
        "minItems": 5,
        "maxItems": 5
      }
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "realm",
    "scanId",
    "part",
    "parts",
    "items"
  ],
  "description": "Everloot upload record: auction_snapshot. The server also checks: realm is a realm name: letters, digits, spaces, apostrophes and hyphens, 2 to 40 characters; part cannot exceed parts."
}
