{
  "$id": "https://everloot.app/schema/records/achievement_catalog.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "achievement_catalog"
    },
    "achievementId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2000000000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "categoryId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000000000
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "parentCategory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "criteriaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000,
      "description": "The achievement's real criteria count; `criteria` keeps the first 100."
    },
    "criteria": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 120
          },
          "required": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000000
          }
        },
        "required": [
          "text",
          "required"
        ]
      }
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "achievementId",
    "name",
    "categoryId",
    "category",
    "points",
    "criteriaCount",
    "criteria"
  ],
  "description": "Everloot upload record: achievement_catalog. The server also checks: criteria cannot outnumber criteriaCount."
}
