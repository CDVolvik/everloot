{
  "$id": "https://everloot.app/schema/records/quest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "quest"
    },
    "questId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "giverNpcId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "turnInNpcId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rewardItemIds": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "category": {
      "description": "The quest log header the quest sits under, a zone or a category. Older addons send none.",
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "faction": {
      "description": "The faction of the character that accepted it. Never the character's name.",
      "type": "string",
      "enum": [
        "alliance",
        "horde"
      ]
    },
    "suggestedGroup": {
      "description": "The suggested group size the quest log shows; absent for a solo quest.",
      "type": "integer",
      "minimum": 2,
      "maximum": 40
    },
    "tag": {
      "description": "The quest tag the game reports, when it reports one.",
      "type": "string",
      "enum": [
        "group",
        "dungeon",
        "raid",
        "pvp"
      ]
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "questId",
    "title",
    "level"
  ],
  "description": "Everloot upload record: quest."
}
