{
  "$id": "https://everloot.app/schema/records/title_owned.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "characterKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "class": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20,
      "pattern": "^[A-Za-z]+$",
      "description": "Class token from UnitClass, e.g. MAGE."
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "kind": {
      "type": "string",
      "const": "title_owned"
    },
    "titleIds": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 5000
      }
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "characterKey",
    "class",
    "level",
    "kind",
    "titleIds"
  ],
  "description": "Everloot upload record: title_owned."
}
