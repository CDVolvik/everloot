{
  "$id": "https://everloot.app/schema/records/recipe_seen.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "recipe_seen"
    },
    "profession": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "recipe": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "skillMin": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "skillMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "reagents": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "item",
          "count"
        ]
      }
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "profession",
    "recipe",
    "skillMin",
    "skillMax",
    "points",
    "reagents"
  ],
  "description": "Everloot upload record: recipe_seen."
}
