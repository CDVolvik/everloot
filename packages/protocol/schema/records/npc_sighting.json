{
  "$id": "https://everloot.app/schema/records/npc_sighting.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "npc_sighting"
    },
    "npcId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mapId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "reaction": {
      "type": "string",
      "enum": [
        "friendly",
        "neutral",
        "hostile"
      ]
    },
    "positionKind": {
      "description": "Whose coordinates were measured; legacy unknown positions never become spawn pins. `interaction` is the player's position while the NPC's window was open, a few yards from the NPC.",
      "type": "string",
      "enum": [
        "player",
        "npc",
        "interaction"
      ]
    },
    "role": {
      "description": "With `interaction`: the window that opened (`NPC_ROLES`). Absent for a gossip window that names no service and from older addons.",
      "type": "string",
      "enum": [
        "vendor",
        "trainer",
        "questgiver",
        "flightmaster",
        "banker",
        "auctioneer",
        "stablemaster",
        "innkeeper",
        "repair"
      ]
    },
    "creatureType": {
      "description": "The creature type the game shows, as `UnitCreatureType` reports it in English. Older addons send none.",
      "type": "string",
      "enum": [
        "Beast",
        "Dragonkin",
        "Demon",
        "Elemental",
        "Giant",
        "Undead",
        "Humanoid",
        "Critter",
        "Mechanical",
        "Not specified",
        "Totem",
        "Non-combat Pet",
        "Gas Cloud"
      ]
    },
    "rank": {
      "description": "`UnitClassification`: normal, elite, rare, rare_elite or boss (`worldboss`). Older addons send none.",
      "type": "string",
      "enum": [
        "normal",
        "elite",
        "rare",
        "rare_elite",
        "boss"
      ]
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "npcId",
    "name",
    "mapId",
    "x",
    "y",
    "level",
    "reaction"
  ],
  "description": "Everloot upload record: npc_sighting."
}
