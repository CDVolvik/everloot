{
  "$id": "https://everloot.app/schema/records/object_sighting.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "object_sighting"
    },
    "objectId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "The object's name in the client's language. Public only when 3 installs agree on it."
    },
    "mapId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "The object's own x on that map, 0 to 100, from the vignette: not the player's."
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "The object's own y on that map, 0 to 100."
    },
    "instanceMapId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "The instance's map id, the 8th return of `GetInstanceInfo`: a map, not a UiMap."
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "objectId",
    "name",
    "mapId",
    "x",
    "y"
  ],
  "description": "Everloot upload record: object_sighting."
}
