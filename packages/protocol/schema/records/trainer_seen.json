{
  "$id": "https://everloot.app/schema/records/trainer_seen.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Random install id, no account needed."
    },
    "eventId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO time the event happened in-game."
    },
    "kind": {
      "type": "string",
      "const": "trainer_seen"
    },
    "profession": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "recipe": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "requiredRank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "costCopper": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000000000
    },
    "trainerNpcId": {
      "description": "The trainer whose window listed it. Older addons send none.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "installId",
    "capturedAt",
    "kind",
    "profession",
    "recipe",
    "requiredRank"
  ],
  "description": "Everloot upload record: trainer_seen."
}
